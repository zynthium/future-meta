from os import PathLike
from typing import Any, Literal, Sequence

SCHEMA_VERSION: int

SymbolKindLiteral = Literal[
    "Futures",
    "MainContinuous",
    "Index",
    "Option",
    "Spread",
    "Unsupported",
]
FeeKindLiteral = Literal[
    "CnyPerLot",
    "TurnoverRatePerTenThousand",
    "Zero",
    "Unknown",
]
TradingStatusLiteral = Literal["Trading", "NotTrading", "Unknown"]

class FutureMetaError(Exception): ...

class ParsedSymbol:
    @property
    def raw(self) -> str: ...
    @property
    def kind(self) -> SymbolKindLiteral: ...
    @property
    def exchange(self) -> str: ...
    @property
    def local(self) -> str: ...
    @property
    def underlying_symbol(self) -> str | None: ...
    def to_dict(self) -> dict[str, Any]: ...

class ContractHandle:
    @property
    def contract_id(self) -> int: ...

class Contract:
    @property
    def id(self) -> int: ...
    @property
    def symbol(self) -> str: ...
    @property
    def listing_date(self) -> str | None: ...
    @property
    def expiry_date(self) -> str | None: ...
    @property
    def lot_size(self) -> float: ...
    @property
    def tick_size(self) -> float: ...
    @property
    def active(self) -> bool: ...
    def tick_value(self) -> float: ...
    def to_dict(self) -> dict[str, Any]: ...

class ContractSpecVersion:
    @property
    def contract_id(self) -> int: ...
    @property
    def lot_size(self) -> float: ...
    @property
    def tick_size(self) -> float: ...
    @property
    def valid_from(self) -> str: ...
    @property
    def valid_to(self) -> str | None: ...
    def tick_value(self) -> float: ...
    def to_dict(self) -> dict[str, Any]: ...

class FeeSpec:
    @property
    def kind(self) -> FeeKindLiteral: ...
    @property
    def value(self) -> float | None: ...
    @property
    def raw_text(self) -> str | None: ...
    def to_dict(self) -> dict[str, Any]: ...

class ContractFee:
    @property
    def contract_id(self) -> int: ...
    @property
    def rule_hash(self) -> str: ...
    @property
    def buy_margin_rate(self) -> float | None: ...
    @property
    def sell_margin_rate(self) -> float | None: ...
    @property
    def open_fee(self) -> FeeSpec: ...
    @property
    def close_yesterday_fee(self) -> FeeSpec: ...
    @property
    def close_today_fee(self) -> FeeSpec: ...
    @property
    def intraday_open_fee(self) -> FeeSpec | None: ...
    @property
    def trading_status(self) -> TradingStatusLiteral: ...
    @property
    def is_main_contract(self) -> bool: ...
    @property
    def source_updated_at(self) -> str | None: ...
    @property
    def valid_from(self) -> str: ...
    @property
    def valid_to(self) -> str | None: ...
    def to_dict(self) -> dict[str, Any]: ...

class PreparedFee:
    @property
    def lot_size(self) -> float: ...
    def open_amount(self, price: float, lots: float) -> float: ...
    def intraday_open_amount(self, price: float, lots: float) -> float | None: ...
    def close_yesterday_amount(self, price: float, lots: float) -> float: ...
    def close_today_amount(self, price: float, lots: float) -> float: ...

class PreparedFeeBook:
    def fees(self) -> list[PreparedFee]: ...
    def get(self, slot: int) -> PreparedFee | None: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def __len__(self) -> int: ...
    def __getitem__(self, slot: int) -> PreparedFee: ...

class PreparedFeeCursors:
    def current_trading_date(self) -> str: ...
    def next_change_unix_nanos(self) -> int: ...
    def len(self) -> int: ...
    def is_empty(self) -> bool: ...
    def get(self, slot: int) -> PreparedFee | None: ...
    def current(self, slot: int) -> PreparedFee: ...
    def advance_to(self, trading_date: str, unix_nanos: int) -> None: ...
    def advance_and_get(
        self, trading_date: str, slot: int, unix_nanos: int
    ) -> PreparedFee: ...
    def advance_and_get_unix_nanos(
        self, slot: int, unix_nanos: int
    ) -> PreparedFee: ...
    def __len__(self) -> int: ...

class TradingDayMeta:
    def trading_date(self) -> str: ...
    def resolve_contract(self, symbol: str) -> ContractHandle: ...
    def contract(self, symbol: str) -> Contract: ...
    def contract_for_handle(self, handle: ContractHandle) -> Contract: ...
    def contract_spec(self, symbol: str) -> ContractSpecVersion: ...
    def contract_spec_for_handle(
        self, handle: ContractHandle
    ) -> ContractSpecVersion: ...
    def fee_rule(self, handle: ContractHandle) -> ContractFee: ...
    def fee_rule_by_symbol(self, symbol: str) -> ContractFee: ...
    def prepare_fee(self, handle: ContractHandle) -> PreparedFee: ...
    def prepare_fee_by_symbol(self, symbol: str) -> PreparedFee: ...
    def prepare_fee_book(
        self, handles: Sequence[ContractHandle]
    ) -> PreparedFeeBook: ...
    def prepare_fee_cursors(
        self, handles: Sequence[ContractHandle], start_unix_nanos: int
    ) -> PreparedFeeCursors: ...

class FutureMeta:
    @staticmethod
    def from_compressed_bytes(data: bytes) -> FutureMeta: ...
    @staticmethod
    def from_file(path: str | PathLike[str]) -> FutureMeta: ...
    @staticmethod
    def load_file(path: str | PathLike[str]) -> FutureMeta: ...
    def resolve_contract(self, symbol: str) -> ContractHandle: ...
    def contract(self, symbol: str) -> Contract: ...
    def contract_for_handle(self, handle: ContractHandle) -> Contract: ...
    def contracts(self) -> list[Contract]: ...
    def contract_spec_asof(
        self, symbol: str, at: str
    ) -> ContractSpecVersion: ...
    def contract_spec_on(
        self, symbol: str, trading_date: str
    ) -> ContractSpecVersion: ...
    def contract_spec_for_handle_asof(
        self, handle: ContractHandle, at: str
    ) -> ContractSpecVersion: ...
    def contract_spec_for_handle_on(
        self, handle: ContractHandle, trading_date: str
    ) -> ContractSpecVersion: ...
    def contract_fee_asof(self, symbol: str, at: str) -> ContractFee: ...
    def contract_fee_on(
        self, symbol: str, trading_date: str
    ) -> ContractFee: ...
    def contract_fee_for_handle_asof(
        self, handle: ContractHandle, at: str
    ) -> ContractFee: ...
    def contract_fee_for_handle_on(
        self, handle: ContractHandle, trading_date: str
    ) -> ContractFee: ...
    def underlying_fees_asof(
        self, underlying_symbol: str, at: str
    ) -> list[ContractFee]: ...
    def underlying_fees_on(
        self, underlying_symbol: str, trading_date: str
    ) -> list[ContractFee]: ...
    def for_trading_day(self, trading_date: str) -> TradingDayMeta: ...
    def prepare_fee_cursors(
        self,
        handles: Sequence[ContractHandle],
        trading_date: str,
        start_unix_nanos: int,
    ) -> PreparedFeeCursors: ...

class DownloadConfig:
    def __init__(
        self,
        manifest_url: str | None = None,
        cache_dir: str | PathLike[str] | None = None,
    ) -> None: ...
    @property
    def manifest_url(self) -> str: ...
    @property
    def cache_dir(self) -> str: ...

class DownloadClient:
    @staticmethod
    def load(config: DownloadConfig | None = None) -> DownloadClient: ...
    def meta(self) -> FutureMeta: ...
    def refresh(self) -> bool: ...

def load_or_fetch(config: DownloadConfig | None = None) -> FutureMeta: ...
def parse_symbol(raw: str) -> ParsedSymbol: ...
def normalize_futures_symbol(exchange: str, local: str) -> str: ...
def derive_underlying_symbol(symbol: str) -> str: ...
def sha256_hex(data: bytes) -> str: ...
def encode_archive_json(json_str: str) -> bytes: ...
