{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-meta-cron-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "35,50 10 * * 1-5",
      "5,20,35 11 * * 1-5",
      "2,7,12 0 * * 1-5",
      "37 0 * * 1-5",
      "17 12 * * 1-5"
    ]
  },
  "vars": {
    "GITHUB_REPO": "zynthium/future-meta",
    "GITHUB_WORKFLOW": "update-fee-data.yml",
    "GITHUB_REF": "main"
  }
}
